# Copy to .env (chmod 600) — or run:  /data/dotnet-sdk/dotnet publish/AgnesService.dll --init-env
# Never commit .env. Read by the service (re-read on change), the --create-user CLI and systemd (EnvironmentFile).

# Agnes API key (leave empty until available: service runs, generation returns 503).
AGNES_API_KEY=

# HS256 signing secret for access tokens, >= 32 chars. --init-env generates one (not printed).
# Empty = login refused with 503 (health/frontend still work). Changing it logs everyone out.
JWT_SECRET=

# PostgreSQL (Npgsql connection string) for schema agnes_auth in db77database.
# On this machine the service runs as OS user "user", which has peer auth over the unix socket:
AGNES_DB_CONNECTION=Host=/var/run/postgresql;Database=db77database;Username=user
# Least-privilege alternative (see README): Host=127.0.0.1;Database=db77database;Username=agnes_service;Password=...
# (A libpq-style AGNES_DB_DSN=dbname=db77database from the Python round is still understood as a fallback.)

# Per-account generation limits — system defaults; per-user overrides live in agnes_auth.users
# (NULL = these defaults). Counted endpoints: POST /api/text, /api/image, /api/video, /api/analyze.
# LIMITS_DEFAULT_PER_MINUTE=10       # sliding 60 s window, per account
# LIMITS_DEFAULT_PER_DAY=200         # all kinds together, per JST calendar day (resets 00:00 Asia/Tokyo)
# LIMITS_DEFAULT_VIDEO_PER_DAY=20    # video sub-quota (also counts toward PER_DAY)
# LIMITS_DEFAULT_CONCURRENT=2        # generation calls in flight per account
# MAX_CONCURRENT=6                   # generation calls in flight, all accounts together

# Optional auth tuning (defaults shown)
# JWT_ACCESS_MINUTES=30
# REFRESH_TOKEN_DAYS=7
# REFRESH_FAMILY_DAYS=30
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# IP_BAN_AFTER_LOCKOUTS=3
# IP_BAN_HOURS=24            # 0 = permanent until removed with --unblock-ip
# IP_MAX_FAILURES=20         # failed logins per IP per 15 min before 429
# TRUST_PROXY=0              # 1 = take client IP from X-Forwarded-For (only behind your own proxy)
# COOKIE_SECURE=auto         # auto = Secure flag when X-Forwarded-Proto is https; 1 / 0 to force

# Optional server / upstream overrides
# HOST=0.0.0.0
# PORT=8793
# AGNES_BASE_URL=https://apihub.agnes-ai.com
# TEXT_TIMEOUT=300
# IMAGE_TIMEOUT=360
# VIDEO_CREATE_TIMEOUT=120
# VIDEO_STATUS_TIMEOUT=30

# ---- TASK6 analyze (POST /api/analyze). Comments must stay on their own lines:
# an inline "# ..." after a value would become part of the value (Settings and systemd do not strip it).
# Gemini API key: filled in by the owner later; empty = gemini not ready (normal). Restart after filling it in
# (systemd EnvironmentFile= freezes keys present at start, see the phase-2 note below).
GEMINI_API_KEY=
# Gemini OpenAI-compatible chat completions URL; empty = https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_API_URL=
# Provider used first when the request names none (agnes | gemini).
ANALYZE_DEFAULT_PROVIDER=gemini
# Fallback order across providers (after trying every model of the first provider).
ANALYZE_PROVIDER_ORDER=gemini,agnes
# Timeout of ONE upstream analyze call, seconds.
ANALYZE_TIMEOUT_S=180
# Whole-request deadline of a direct /api/analyze call, seconds (phase 2: now configurable; default unchanged).
# ANALYZE_DEADLINE_S=600

# ---- TASK6 phase 2: reading ingest orchestration (POST /api/reading/ingest; TASK6-PHASE2-PLAN.md §2).
# IMPORTANT (plan §1.6 / P2R-5): systemd EnvironmentFile= loads this file into the process environment at start,
# and environment variables win — every key present here at start-up is frozen. Change ANY key → restart agnes-service.
#
# TtsWeb (local, 127.0.0.1) and the agnes-service write token issued by TtsWeb (tokens.json entry "agnes-service",
# can_act_for A001,A002,A003,web). Secret: 0600 file, redacted in logs, never sent to the browser.
TTSWEB_URL=http://127.0.0.1:8791
TTSWEB_TOKEN=
# TtsWeb PUBLIC root (the 8791 public address, no trailing slash). Used to build the absolute short link
# <TTSWEB_PUBLIC_URL>/v3?s=<id> returned to the「添加文章」page (/add, served on 8793). Empty = relative /v3?s=<id>.
# Restart after changing it.
TTSWEB_PUBLIC_URL=
# TTSWEB_TIMEOUT_S=30
#
# Orchestration (defaults shown = plan §2.2 values)
# INGEST_WORKERS=2                  # own worker pool, does not use the Generate concurrency slots
# INGEST_DEADLINE_S=420             # counted from the start of enrich; then the finished part is committed
# INGEST_CHUNK_SENTS_GEMINI=20
# INGEST_CHUNK_CHARS_GEMINI=1500
# INGEST_CHUNK_SENTS_AGNES=8
# INGEST_CHUNK_CHARS_AGNES=600
# INGEST_TIMEOUT_GEMINI_LITE_S=45
# INGEST_TIMEOUT_GEMINI_FLASH_S=90
# INGEST_TIMEOUT_AGNES_S=120
# INGEST_RETRY_SCHEDULE_S=900,3600,14400   # delayed whole-article retries (web channel), then L2
# INGEST_T_BACKOFF_S=60,300,900,3600        # T state (TtsWeb unavailable) back-off, last value repeats
# INGEST_T_MAX_S=86400                      # give up the T state after 24 h
# INGEST_SCAN_S=60                  # retry scanner period
# INGEST_RECONCILE_S=3600           # L2 automatic reconciliation period
# INGEST_JOB_KEEP_DAYS=30
# INGEST_KANA_MIN_PERCENT=10        # lang=ja but kana below this share → stored as original only (D8 guard)
# INGEST_READINGS_CHECK=1           # ask TtsWeb /api/v1/ingest/readings_check before accepting reading rewrites
#
# Upstream token buckets (P2R-4), requests per minute; 0 = off. Cover ALL Agnes calls (text/image/video/analyze/ingest).
# UPSTREAM_RPM_AGNES=18
# INGEST_UPSTREAM_RPM_AGNES=12      # orchestration sub-quota inside the Agnes bucket
# UPSTREAM_RPM_GEMINI=0
# INGEST_UPSTREAM_RPM_GEMINI=0
#
# Circuit breakers (per provider+model; in memory)
# CIRCUIT_429_COOLDOWN_S=120        # when the 429 carries no retryDelay / Retry-After
# CIRCUIT_QUOTA_COOLDOWN_S=3600     # 403 mentioning quota
# CIRCUIT_AUTH_COOLDOWN_S=21600     # auth errors (whole provider)
# CIRCUIT_TRANSIENT_COOLDOWN_S=300
# CIRCUIT_QUALITY_COOLDOWN_S=86400  # E7: 3 articles in a row failing validation on one provider
