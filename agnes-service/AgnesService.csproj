<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgnesService</RootNamespace>
    <AssemblyName>AgnesService</AssemblyName>
    <Version>3.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- keep legacy Python, tests, publish output and scratch dirs out of the build globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);python-legacy/**;research/**;tests/**;publish/**;.probe/**;claude-run*;run*.status;*.md;.env*</DefaultItemExcludes>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same packages as the dbapi project; both resolve from the local NuGet cache. -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frontend ships next to AgnesService.dll in bin/ and publish/ -->
    <Content Include="index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="auth_schema.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
